#!/usr/bin/env bash
# KUPOL public CLI — wraps the duo-agents engine binary.
set -euo pipefail

usage() {
  cat <<'EOF'
KUPOL — security dome over your repo
https://kupol.app

Usage:
  kupol scan [path ...] [-f table|json|markdown] [-o file] [--fail-on low|medium|high|critical]
  kupol serve
  kupol init
  kupol mcp
  kupol info
  kupol demo
  kupol help

--fail-on: exit 1 if any finding is at least that severe (critical > high > medium > low).
If omitted, exit with the engine's status.

.kupol.yml: fail_on is the recommended CI default (pass it as --fail-on).
ignore globs in .kupol.yml are planned — the engine has no ignore CLI flag yet
(it already skips target/, node_modules/, and .git/ internally).

Engine lookup: $KUPOL_BIN, duo-agents on PATH,
./target/release/duo-agents, ./release_build/duo-agents
EOF
}

find_engine() {
  if [ -n "${KUPOL_BIN:-}" ]; then
    if [ -f "$KUPOL_BIN" ]; then
      printf '%s\n' "$KUPOL_BIN"
      return 0
    fi
    echo "kupol: KUPOL_BIN is set but not a file: $KUPOL_BIN" >&2
    return 1
  fi

  if command -v duo-agents >/dev/null 2>&1; then
    command -v duo-agents
    return 0
  fi

  local cand
  for cand in \
    ./target/release/duo-agents \
    ./target/release/duo-agents.exe \
    ./release_build/duo-agents \
    ./release_build/duo-agents.exe
  do
    if [ -f "$cand" ]; then
      printf '%s\n' "$cand"
      return 0
    fi
  done

  echo "kupol: engine not found. Set KUPOL_BIN, install duo-agents on PATH, or build with cargo build --release." >&2
  return 1
}

json_hits_threshold() {
  local json_file="$1"
  local threshold="$2"
  local py
  py="$(command -v python3 || command -v python || true)"
  if [ -n "$py" ]; then
    "$py" - "$json_file" "$threshold" <<'PY'
import json, sys
rank = {"info": 0, "low": 1, "medium": 2, "high": 3, "critical": 4}
path, thr_name = sys.argv[1], sys.argv[2].lower()
thr = rank.get(thr_name)
if thr is None:
    sys.stderr.write("kupol: invalid --fail-on %s\n" % thr_name)
    sys.exit(2)
with open(path, encoding="utf-8") as f:
    data = json.load(f)
findings = data.get("findings", []) if isinstance(data, dict) else []
c = h = m = l = i = 0
for item in findings:
    sev = str(item.get("severity", "")).lower()
    if sev == "critical":
        c += 1
    elif sev == "high":
        h += 1
    elif sev == "medium":
        m += 1
    elif sev == "low":
        l += 1
    else:
        i += 1
sys.stderr.write(
    "kupol: count critical=%d high=%d medium=%d low=%d info=%d\n" % (c, h, m, l, i)
)
for item in findings:
    sev = str(item.get("severity", "")).lower()
    if rank.get(sev, 0) >= thr:
        sys.exit(1)
sys.exit(0)
PY
    return $?
  fi

  local want
  case "$(printf '%s' "$threshold" | tr '[:upper:]' '[:lower:]')" in
    low) want='Critical|High|Medium|Low' ;;
    medium) want='Critical|High|Medium' ;;
    high) want='Critical|High' ;;
    critical) want='Critical' ;;
    *) echo "kupol: invalid --fail-on $threshold" >&2; return 2 ;;
  esac
  if grep -Eqi "\"severity\":[[:space:]]*\"($want)\"" "$json_file"; then
    return 1
  fi
  return 0
}

merge_json_files() {
  local out="$1"
  shift
  local py
  py="$(command -v python3 || command -v python || true)"
  if [ -z "$py" ]; then
    cat "$1" > "$out"
    return 0
  fi
  "$py" - "$out" "$@" <<'PY'
import json, sys
out = sys.argv[1]
merged = {"findings": [], "summary": {}, "target": []}
for path in sys.argv[2:]:
    with open(path, encoding="utf-8") as f:
        data = json.load(f)
    if isinstance(data, dict):
        merged["findings"].extend(data.get("findings") or [])
        t = data.get("target")
        if t:
            merged["target"].append(t)
merged["target"] = " ".join(merged["target"])
with open(out, "w", encoding="utf-8") as f:
    json.dump(merged, f)
PY
}

ENGINE="$(find_engine)"

CMD="${1:-help}"
if [ "$#" -gt 0 ]; then
  shift
fi

case "$CMD" in
  help|-h|--help)
    usage
    ;;
  scan)
    paths=()
    format="table"
    output=""
    fail_on=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -f|--format)
          format="${2:-}"
          shift 2
          ;;
        -o|--output)
          output="${2:-}"
          shift 2
          ;;
        --path)
          paths+=("${2:-}")
          shift 2
          ;;
        --fail-on)
          fail_on="${2:-}"
          shift 2
          ;;
        -*)
          echo "kupol scan: unknown option: $1" >&2
          usage >&2
          exit 1
          ;;
        *)
          paths+=("$1")
          shift
          ;;
      esac
    done
    if [ "${#paths[@]}" -eq 0 ]; then
      paths=(".")
    fi

    case "$format" in
      table|json|markdown|md) ;;
      *) echo "kupol scan: invalid format: $format" >&2; exit 1 ;;
    esac
    if [ "$format" = "md" ]; then
      format="markdown"
    fi

    if [ -z "$fail_on" ]; then
      last_rc=0
      for p in "${paths[@]}"; do
        if [ -n "$output" ] && [ "${#paths[@]}" -eq 1 ]; then
          "$ENGINE" scan --path "$p" --format "$format" --output "$output" || last_rc=$?
        else
          "$ENGINE" scan --path "$p" --format "$format" || last_rc=$?
        fi
      done
      exit "$last_rc"
    fi

    case "$(printf '%s' "$fail_on" | tr '[:upper:]' '[:lower:]')" in
      low|medium|high|critical) ;;
      *) echo "kupol scan: --fail-on must be low|medium|high|critical" >&2; exit 1 ;;
    esac

    json_tmp="$(mktemp)"
    json_parts=()
    md_parts=()
    trap 'rm -f "${json_parts[@]}" "${md_parts[@]}" "$json_tmp"' EXIT

    for p in "${paths[@]}"; do
      part="$(mktemp)"
      json_parts+=("$part")
      "$ENGINE" scan --path "$p" --format json --output "$part" || true
      if [ "$format" != "json" ]; then
        if [ -n "$output" ]; then
          mdpart="$(mktemp)"
          md_parts+=("$mdpart")
          "$ENGINE" scan --path "$p" --format "$format" --output "$mdpart" || true
        else
          "$ENGINE" scan --path "$p" --format "$format" || true
        fi
      fi
    done

    merge_json_files "$json_tmp" "${json_parts[@]}"

    if [ "$format" = "json" ]; then
      if [ -n "$output" ]; then
        cp "$json_tmp" "$output"
      else
        cat "$json_tmp"
      fi
    elif [ -n "$output" ]; then
      : > "$output"
      idx=0
      for p in "${paths[@]}"; do
        {
          printf '# Scan: %s\n\n' "$p"
          cat "${md_parts[$idx]}"
          printf '\n'
        } >> "$output"
        idx=$((idx + 1))
      done
    fi

    set +e
    json_hits_threshold "$json_tmp" "$fail_on"
    gate_rc=$?
    set -e
    if [ "$gate_rc" -eq 2 ]; then
      exit 2
    fi
    if [ "$gate_rc" -eq 1 ]; then
      echo "kupol: findings at or above --fail-on $fail_on" >&2
      exit 1
    fi
    exit 0
    ;;
  serve|init|mcp|info|demo)
    exec "$ENGINE" "$CMD" "$@"
    ;;
  *)
    echo "kupol: unknown command: $CMD" >&2
    usage >&2
    exit 1
    ;;
esac
